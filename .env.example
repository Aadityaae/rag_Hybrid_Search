# Free tier: get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GENERATION_MODEL=llama-3.3-70b-versatile
LLM_JUDGE_MODEL=llama-3.1-8b-instant

# Local embeddings (sentence-transformers) -- no key needed, runs on your machine
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Proactive throttle: kept under Groq's free-tier ~30 requests/minute per
# model cap so the pipeline self-paces instead of hitting 429s. Lower this
# if you're on a more restrictive tier; raise it if you upgrade.
GROQ_RPM_LIMIT=25
